GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The e2e suite runs against its own database. By default the runner manages
# the local compose service `db-e2e` itself: it starts it when down, recreates
# the schema, migrates and seeds fixture accounts, and stops it after the run
# only if it started it. Set E2E_DATABASE_URL to use an external database
# instead (CI, a long-running instance) — Docker is then left alone.
# E2E_DATABASE_URL=postgres://swearjar:swearjar@localhost:5433/swearjar_e2e
# Set automatically by Playwright to isolate its Next.js output.
# SWEARJAR_E2E=1
